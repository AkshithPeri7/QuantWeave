# Copy to .env in repository root. Never commit .env.
ENVIRONMENT=development
DEMO_MODE=true
# PostgreSQL is the primary target database:
DATABASE_URL=postgresql+psycopg://quantweave:quantweave_dev@localhost:5432/quantweave
# For local development without Docker, SQLite fallback is supported:
# DATABASE_URL=sqlite:///./quantweave_dev.db

CORS_ORIGINS=["http://localhost:3000"]

# Authentication & Security
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional provider credentials. Add only credentials you are authorised to use.
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
MUTUAL_FUND_PROVIDER=demo
NEWS_PROVIDER=
NEWS_API_KEY=

# AI Copilot configuration (Milestone 8)
# Supported providers: mock, gemini, openai, none
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=quantweave-mock-agent-v1
AI_MAX_TOOL_CALLS=5
AI_TIMEOUT_SECONDS=15
OLLAMA_BASE_URL=http://localhost:11434
